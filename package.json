{
  "name": "argus-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Connects outbound to the Argus gateway and runs read-only ops in the cluster",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --env-file=dev/runner.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "dev:gateway": "node dev/gateway.ts"
  },
  "dependencies": {
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "typescript": "^7.0.2"
  }
}
